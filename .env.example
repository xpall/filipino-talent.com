# Production defaults. Copy to .env and edit.
DEBUG=0
SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
ALLOWED_HOSTS=filipino-talent.com,www.filipino-talent.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://filipino-talent.com,https://www.filipino-talent.com
SITE_URL=https://filipino-talent.com
ZONE=filipino-talent.com

# Host-facing port only. The container always listens on 8000 internally.
# Give each app on the VPS a unique value.
APP_PORT=8020
GUNICORN_WORKERS=3
# The container app user owns ./data. Default 1000 matches a typical VPS user;
# change both and rebuild if your deploy user has a different UID/GID.
APP_UID=1000
APP_GID=1000
# SQLite lives at /app/data/db.sqlite3 in Docker and ./data/db.sqlite3 locally.
# Override only if you know you need a different path.
# DATABASE_PATH=/app/data/db.sqlite3

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID)
# Authorized redirect URI:
#   https://filipino-talent.com/accounts/google/login/callback/
# For local dev also add:
#   http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare API token: Zone -> DNS -> Edit for filipino-talent.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Comma-separated Google emails allowed to use /dashboard.
ADMIN_EMAILS=

# Abuse limits
MAX_PER_IP_PER_DAY=6
MAX_PER_EMAIL_PER_DAY=3
MAX_LIVE_PER_USER=2

# Local development overrides:
# DEBUG=1
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8000
# SITE_URL=http://localhost:8000
# DATABASE_PATH=./data/db.sqlite3
