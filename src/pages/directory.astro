---
import Base from '../layouts/Base.astro';
---

<Base>
<section>
  <h1>Subdomain directory</h1>
  <p class="lead">Sites using a filipino-talent.com subdomain.</p>
  <input id="search" placeholder="Search by subdomain or GitHub…" style="max-width:420px;margin-top:8px" />
</section>

<div id="list" class="grid" style="margin-top:24px">
  <p class="muted">Loading…</p>
</div>

<script>
  const list = document.getElementById('list') as HTMLDivElement;
  const search = document.getElementById('search') as HTMLInputElement;
  const API = (import.meta.env.PUBLIC_API_BASE ?? 'https://api.filipino-talent.com').replace(/\/$/, '');

  interface Domain {
    subdomain: string;
    portfolio_url: string | null;
    github_username: string | null;
  }

  let domains: Domain[] = [];

  const esc = (value: unknown) =>
    String(value ?? '').replace(
      /[&<>"']/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );

  function render(items: Domain[]) {
    if (!items.length) {
      list.innerHTML = '<p class="muted">No subdomains yet. Be the first!</p>';
      return;
    }
    list.innerHTML = items
      .map((d) => {
        const href = d.portfolio_url ?? `https://${d.subdomain}.filipino-talent.com`;
        return `
        <a class="card" href="${esc(href)}" target="_blank" rel="noopener noreferrer" style="text-decoration:none">
          <strong style="color:var(--text)">${esc(d.subdomain)}</strong>
          ${d.github_username ? `<p class="muted" style="margin:8px 0 0;font-size:.9rem">@${esc(d.github_username)}</p>` : ''}
        </a>`;
      })
      .join('');
  }

  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    render(
      domains.filter(
        (d) =>
          !q ||
          d.subdomain.toLowerCase().includes(q) ||
          (d.github_username ?? '').toLowerCase().includes(q),
      ),
    );
  });

  fetch(`${API}/domains`)
    .then((r) => r.json())
    .then((data) => {
      domains = data.domains ?? [];
      render(domains);
    })
    .catch(() => {
      list.innerHTML = '<p class="muted">Could not load the directory right now.</p>';
    });
</script>
</Base>
