---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'filipino-talent.com · free subdomains for Filipino remote workers',
  description = 'Claim a free yourname.filipino-talent.com subdomain and point it at your portfolio on GitHub Pages, Cloudflare Pages, Netlify, Vercel, or any static host.',
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/guide', label: 'Guide' },
  { href: '/directory', label: 'Directory' },
  { href: '/submit', label: 'Get a subdomain' },
];
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.setAttribute('data-theme', theme);
        } catch (e) {
          root.setAttribute('data-theme', 'light');
        }
        window.addEventListener('DOMContentLoaded', function () {
          var btn = document.getElementById('theme-toggle');
          if (!btn) return;
          btn.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch (e) {}
          });
        });
      })();
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">filipino<span>-talent</span>.com</a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p class="footer-note">
          A free service for Filipino remote workers. It stays free for as long as it can run within Cloudflare's free tier.
        </p>
        <div class="footer-links">
          <a href="/guide">Guide</a>
          <a href="/terms">Terms</a>
          <a href="mailto:verify@filipino-talent.com">Contact</a>
          <span class="footer-copy">© 2026 <a href="https://johnlloyd.dev">johnlloyd.dev</a></span>
        </div>
      </div>
    </footer>
  </body>
</html>
